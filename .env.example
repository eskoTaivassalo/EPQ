# Firebase Configuration Template
# HUOM: Tämä projekti EI käytä .env-tiedostoja Firebase-konfiguraatioon!
# 
# Sen sijaan käytä: src/config/firebaseConfig.js
# 1. Kopioi: src/config/firebaseConfig.example.js -> src/config/firebaseConfig.js
# 2. Täytä omat Firebase-tietosi firebaseConfig.js:ään
# 3. firebaseConfig.js on automaattisesti .gitignore-listalla
#
# Jos haluat käyttää .env-tiedostoja:
# 1. Asenna: npm install react-native-dotenv
# 2. Konfiguroi babel.config.js
# 3. Käytä: process.env.FIREBASE_API_KEY jne.
#
# Esimerkkiarvot (VAIHDA OMAT TIETOSI):
# FIREBASE_API_KEY=your_api_key_here
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# FIREBASE_APP_ID=your_app_id