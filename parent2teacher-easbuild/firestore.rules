rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    
    // ========================================
    // USERS COLLECTION (Main profiles)
    // ========================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
      
      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow write: if isAuthenticated(); // Anyone can create notifications for user
        allow delete: if isOwner(userId);
      }
    }
    
    // ========================================
    // SERVICE TYPES COLLECTION
    // serviceTypes/{serviceType}/{collectionName}/{userId}
    // ========================================
    
    // Role profiles (teachers, students, therapists, etc.)
    match /serviceTypes/{serviceType}/{collectionName}/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
      
      // Messages subcollection (messages stored under sender's document)
      match /messages/{messageId} {
        // Allow read if user is sender, recipient, or any participant in the conversation
        allow read: if isAuthenticated() && (
          request.auth.uid == resource.data.senderId ||
          request.auth.uid == resource.data.recipientId ||
          request.auth.uid == resource.data.teacherId ||
          request.auth.uid == resource.data.parentId
        );
        // Only the sender (owner of parent document) can create messages
        allow create: if isAuthenticated() && (
          request.auth.uid == userId ||
          request.auth.uid == request.resource.data.senderId
        );
        // Allow update for sender or recipient (e.g., marking as read)
        allow update: if isAuthenticated() && (
          request.auth.uid == resource.data.senderId ||
          request.auth.uid == resource.data.recipientId ||
          request.auth.uid == resource.data.teacherId ||
          request.auth.uid == resource.data.parentId
        );
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.senderId;
      }
      
      // Availability Slots subcollection
      match /availabilitySlots/{slotId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId);
        // Allow update if: owner, OR anyone can book/update available slots
        allow update: if isAuthenticated();
        allow delete: if isOwner(userId);
      }
      
      // Bookings subcollection
      match /bookings/{bookingId} {
        // Allow read if: path owner, OR booking participant
        allow read: if isAuthenticated() && (
          isOwner(userId) || 
          (resource != null && (
            request.auth.uid == resource.data.teacherId || 
            request.auth.uid == resource.data.parentId
          ))
        );
        // Allow create for any authenticated user (for booking creation)
        allow create: if isAuthenticated();
        // Allow update for participants
        allow update: if isAuthenticated() && (
          isOwner(userId) || 
          (resource != null && (
            request.auth.uid == resource.data.teacherId || 
            request.auth.uid == resource.data.parentId
          ))
        );
        allow delete: if isOwner(userId) || isAdmin();
      }
    }
    
    // ========================================
    // COLLECTION GROUP QUERIES
    // ========================================
    
    match /{path=**}/teachers/{teacherId} {
      allow read: if isAuthenticated();
    }
    
    match /{path=**}/students/{studentId} {
      allow read: if isAuthenticated();
    }
    
    match /{path=**}/therapists/{therapistId} {
      allow read: if isAuthenticated();
    }
    
    match /{path=**}/coaches/{coachId} {
      allow read: if isAuthenticated();
    }
    
    match /{path=**}/availabilitySlots/{slotId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Allow authenticated users to book slots
    }
    
    match /{path=**}/bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.teacherId || 
        request.auth.uid == resource.data.parentId
      );
      allow write: if isAuthenticated();
    }
    
    // Messages collection group (for conversation queries)
    match /{path=**}/messages/{messageId} {
      // Allow read if user is involved in the conversation
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.recipientId ||
        request.auth.uid == resource.data.teacherId ||
        request.auth.uid == resource.data.parentId
      );
      // Create allowed if authenticated (handled by parent document rules)
      allow create: if isAuthenticated();
      // Update allowed if participant
      allow update: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.recipientId ||
        request.auth.uid == resource.data.teacherId ||
        request.auth.uid == resource.data.parentId
      );
      // Delete only by sender
      allow delete: if isAuthenticated() && (
        resource != null &&
        request.auth.uid == resource.data.senderId
      );
    }
    
    // ========================================
    // ADMIN COLLECTION
    // ========================================
    match /admins/{adminEmail} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
